* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
backend/mvnw text eol=lf
# Preserve locked serialized artifacts and exact dataset bytes.
*.joblib binary
*.pkl binary
*.pickle binary
*.npz binary
*.npy binary
*.png binary
*.pptx binary
*.pdf binary
*.csv -text
ml/** -text
data/** -text
data/*.csv filter=lfs diff=lfs merge=lfs -text
data/final100/scada/*.csv filter=lfs diff=lfs merge=lfs -text
data/final100/commissioning/*.csv filter=lfs diff=lfs merge=lfs -text
